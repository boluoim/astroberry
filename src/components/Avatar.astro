---
import { Image } from 'astro:assets'
import AvatarSrc from '~assets/avatar.svg'

interface Props {
    class?: string
}

const props = Astro.props;
---
<a href="/">
    <Image
        src={AvatarSrc}
        alt="avatar"
        class:list={[props.class]}
        class="w-24 h-24 rounded-full cursor-pointer"
        transition:name="avatar"
    />
</a>
